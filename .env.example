# --- LLM brain: open models on Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_...
# LiteLLM gateway: models are "provider/model". Groq options on your key:
#   groq/openai/gpt-oss-120b -> best tool-calling / ordering accuracy (default)
#   groq/openai/gpt-oss-20b  -> cheapest & fastest, lighter conversation quality
#   groq/qwen/qwen3.8-27b    -> strong multilingual (preview on Groq)
LLM_MODEL=groq/openai/gpt-oss-120b
# tried instantly when the main model is rate-limited/down (free tier = 8K tokens/min); also runs chat summaries
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-20b
# optional 3rd option on another provider so a Groq outage doesn't stop the cafe, e.g.:
#   LLM_BACKUP_MODEL=cerebras/gpt-oss-120b            and   CEREBRAS_API_KEY=...
#   LLM_BACKUP_MODEL=openrouter/openai/gpt-oss-120b   and   OPENROUTER_API_KEY=sk-or-...
LLM_BACKUP_MODEL=
# seconds a failing model is skipped before being retried
LLM_COOLDOWN_SECONDS=30
# give up on a model that hasn't answered within this many seconds and fail over
LLM_TIMEOUT_SECONDS=20

# --- Usage metering & billing (Redis) ---
REDIS_URL=redis://localhost:6379/0
# every table visit gets this many free AI chat minutes, then this price per minute goes on the bill
AI_FREE_MINUTES=10
AI_PRICE_PER_MINUTE=2
# show short chat snippets in the manager's live monitor (false = metadata only, better for customer privacy)
MONITOR_CHAT_TEXT=false
# reasoning models only (gpt-oss / qwen): low = fastest replies for live voice; medium/high = more thoughtful
LLM_REASONING_EFFORT=low

# --- Sarvam AI (Indian speech-to-text + text-to-speech) ---
# Get a key at https://dashboard.sarvam.ai . Leave empty to fall back to the browser's built-in voice.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# --- Store ---
CAFE_NAME=Deccan House
# the AI companion's name as shown in the app (it says it plainly: "Chaimate")
COMPANION_NAME=ChAimate
CAFE_CITY=Hyderabad
CURRENCY=₹
STAFF_PIN=1234
# Public URL customers' phones use to reach this server (for table QR codes).
# Phones need HTTPS for the microphone: run scripts/https.sh and use e.g. https://192.168.1.20:8443
PUBLIC_BASE_URL=http://localhost:8000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text (readable) or json (one object per line, for log platforms)
LOG_FORMAT=text
# folder for cafe.log and errors.log (rotated at 10 MB, 5 kept); empty = console only
LOG_DIR=logs

# --- Database: Supabase (PostgreSQL + Realtime) ---
# Leave empty to use a local SQLite file instead (data/cafe.db, or the path in DB_PATH).
DB_PATH=
# Supabase dashboard → Connect → "Session pooler" (port 5432) → copy the URI and fill in your DB password:
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# tables are created in this private schema (not exposed through Supabase's public API)
DB_SCHEMA=cafe
# Optional live change feed. Project Settings → API: Project URL, and the secret / service_role key.
# SECRET — keep it here only, never in the browser or in chat.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
